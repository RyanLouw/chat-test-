{

  "IsDevelopment": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },


  "ConnectionStrings": {
    "ADUser": "#centralconfig.repdbadusers",

    "CallQualityDb": "#centralconfig.callquality",

    "PRP": "#centralconfig.unindops",
    "DischemSRS": "#centralconfig.dischemsrs",
    "DischemPRP": "#centralconfig.dischemprp"
  },


  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "healthwindow.co.za",
    "ClientId": "#centralconfig.auto.clientid",
    "TenantId": "#centralconfig.auto.tenantid",
    "ClientSecret": "#centralconfig.auto.clientsecret",
    "CallbackPath": "/signin-oidc"
  },


  "CentralConfig": {
    "ClientId": "#{CentralConfig.ClientId}#",
    "BaseUrl": "#{CentralConfig.BaseUrl}#",
    "AuthSalt": "#{CentralConfig.AuthSalt}#",
    "IgnoreEnvironment": false,
    "IncludeAutoSettings": true
  },

  "Roles": {
    "Operator": "#{Roles.Operator}#",
    "Assessor": "#{Roles.Assessor}#",
    "Manager": "#{Roles.Manager}#",
    "It": "#{Roles.It}#"
  },


  "ApiAccess": {
    "TrainingRegister": {
      "BaseUrl": "#{ApiAccess.TrainingRegister.BaseUrl}#",
      "Key": "#{ApiAccess.TrainingRegister.Key}#"
    },
    "PSP": {
      "BaseUrl": "#{ApiAccess.PSP.BaseUrl}#",
      "IsDevelopment": "#{ApiAccess.PSP.IsDevelopment}#"
    },
    "AbbViePSPApi": {
      "BaseUrl": "#{ApiAccess.AbbViePSPApi.BaseUrl}#",
      "IsDevelopment": "#{ApiAccess.AbbViePSPApi.IsDevelopment}#"
    },

    "ThreeCX": {
      "BaseUrl": "#{ApiAccess.ThreeCX.BaseUrl}#"
    }
  },


  "Email": {
    "host": "outlook.office365.com",
    "fromEmail": "#centralconfig.cqemail-fromemail",
    "fromEmailPassword": "#centralconfig.cqemail-fromemailpassword",
    "fromEmailName": "#centralconfig.cqemail-fromemailname",
    "DemoEmails": "#centralconfig.cqemail-demoemails",
    "ViewOperatorAssessmentURL": "#centralconfig.cqemail-baseurl"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\CallQuality\\log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 31,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },




  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "APPLICATIONINSIGHTS_ENABLE_LIVE_METRICS": "true",
  "APPLICATIONINSIGHTS_SAMPLE_RATIO": "0.5",



  "AllowedHosts": "*"
}
