@using System.Linq
@using CallQuality.Core.Manager.TrainingManager.Models
@model TrainingVM

@{
    ViewData["Title"] = "Training Register";
}

<div class="container-fluid py-4">
    <h1 class="display-5 fw-bold text-center mb-4" style="color:#0B5B75;">Training Register</h1>

    <button class="btn btn-secondary btn-sm mb-3"
            onclick="goToTrainingDetails()">
            New Training Details
    </button>

    <button class="btn btn-secondary btn-sm mb-3" type="button"
            onclick="exportTraining()">
            Export Excel
    </button>

    <!--  Tabs -->
    <ul class="nav nav-tabs mb-4 border-bottom border-2" id="trainingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold text-primary" id="user-details-tab"
                    data-bs-toggle="tab" data-bs-target="#user-details" type="button" role="tab"
                    aria-controls="user-details" aria-selected="true">
                 User Training Details
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold text-primary" id="overview-tab"
                    data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab"
                    aria-controls="overview" aria-selected="false">
                Training Register Overview
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold text-primary" id="suggested-tab"
                    data-bs-toggle="tab" data-bs-target="#suggested" type="button" role="tab"
                    aria-controls="suggested" aria-selected="false">
                 Suggested Training
            </button>
        </li>
    </ul>

    <!--  Tab Content -->
    <div class="tab-content" id="trainingTabsContent">

        <!--  User Training Details -->
        <div class="tab-pane fade show active" id="user-details" role="tabpanel" aria-labelledby="user-details-tab">
            <div class="container-fluid mt-4">
                <div class="table-actions d-flex justify-content-end mb-3">
                    <input type="text" id="trainingSearch" class="form-control page-input"
                           placeholder="  Search Name, Department, or Topic..." style="max-width: 350px;">
                </div>

                <div class="table-responsive">
                    <table class="tracking-table" id="trainingTable">
                        <thead>
                            <tr>
                                <th>User Name</th>
                                <th>Department</th>
                                <th>Training Topic</th>
                                <th>Training Date</th>
                                <th>User Signed</th>
                                <th>Facilitator</th>
                                <th>Uploaded By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.UserTrainings != null && Model.UserTrainings.Any())
                            {
                                foreach (var item in Model.UserTrainings)
                                {
                                    <tr>
                                        <td>@item.UserName</td>
                                        <td>@item.Department</td>
                                        <td>@item.TrainingTopic</td>
                                        <td>@item.TrainingDate?.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (item.UserSigned == true)
                                            {
                                                <span class="text-success fw-semibold">Signed</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger fw-semibold">Not Signed</span>
                                            }
                                        </td>
                                        <td>@item.Facilitator</td>
                                        <td>@item.UploadedBy</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">No training data available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Training pagination" class="mt-3">
                    <ul class="pagination justify-content-center" id="pagination"></ul>
                </nav>
            </div>
        </div>

        <!--  Training Register Overview -->
        <div class="tab-pane fade" id="overview" role="tabpanel" aria-labelledby="overview-tab">
            <div class="container-fluid mt-4">
                <div class="table-actions d-flex justify-content-end mb-3">
                    <input type="text" id="overviewSearch" class="form-control page-input"
                           placeholder="  Search Training Name, Description, or Uploaded By..."
                           style="max-width: 350px;">
                </div>

                <div class="table-responsive">
                    <table class="tracking-table" id="overviewTable">
                        <thead>
                            <tr>
                                <th>Training Name</th>
                                <th>Description</th>
                                <th>Training Date</th>
                                <th>Due Date</th>
                                <th>Duration</th>
                                <th>Created On</th>
                                <th>Uploaded By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.ExistingRegisters != null && Model.ExistingRegisters.Any())
                            {
                                foreach (var item in Model.ExistingRegisters)
                                {
                                    <tr>
                                        <td>@item.TrainingRegisterName</td>
                                        <td>@item.TrainingRegisterDescription</td>
                                        <td>@item.TrainingRegisterDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.TrainingRegisterDueDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.TrainingRegisterTimeDuration</td>
                                        <td>@item.CreatedOn.ToString("yyyy-MM-dd")</td>
                                        <td>@item.UploadedBy</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">No overview data available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Overview pagination" class="mt-3">
                    <ul class="pagination justify-content-center" id="overviewPagination"></ul>
                </nav>
            </div>
        </div>

        <!--  Suggested Training -->
        <div class="tab-pane fade" id="suggested" role="tabpanel" aria-labelledby="suggested-tab">
            <div class="container-fluid mt-4">

                <!--  Search -->
                <div class="table-actions d-flex justify-content-end mb-3">
                    <input type="text" id="suggestedSearch" class="form-control page-input"
                           placeholder="  Search Agent, Department, or Question..."
                           style="max-width: 350px;">
                </div>

                <!--  Accordion Table -->
                <div class="table-responsive shadow-sm rounded suggested-table-wrapper">
                    <table class="table align-middle suggested-table text-center">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>Agent Name</th>
                                <th>Extension</th>
                                <th>Department</th>
                                <th>Average Score</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.SuggestedTrainings != null && Model.SuggestedTrainings.Any())
                            {
                                int index = 0;
                                foreach (var s in Model.SuggestedTrainings)
                                {
                                    var collapseId = $"collapseS{index}";

                                    <tr class="suggested-row" data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                        aria-expanded="false" style="cursor:pointer;">
                                        <td>@s.AgentName</td>
                                        <td>@s.Extension</td>
                                        <td>@s.Department</td>
                                        <td>@s.AverageScore.ToString("F2")%</td>
                                        <td class="text-center">
                                            <i class="bi bi-chevron-down text-primary toggle-icon"></i>
                                        </td>
                                    </tr>

  
                                    <tr class="collapse bg-light suggested-detail" id="@collapseId">
                                        <td colspan="5">
                                            <div class="p-3">
                                                <button class="btn btn-primary btn-sm mb-3"
                                                        onclick='assignSuggestedTraining(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s)))'>
                                                      Add Training
                                                </button>


                                                <table class="table table-sm table-striped mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Question</th>
                                                            <th>Times Missed</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (s.MissedQuestions?.Any() ?? false)
                                                        {
                                                            foreach (var q in s.MissedQuestions)
                                                            {
                                                                <tr>
                                                                    <td>@q.QuestionValue</td>
                                                                    <td>@q.MissedCount</td>
                                                                </tr>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr>
                                                                <td colspan="2" class="text-center text-muted">
                                                                    No missed questions found.
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>

                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No suggested training data available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!--  Pagination -->
                <nav class="d-flex justify-content-center mt-4">
                    <ul class="pagination suggested-pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            setupTable("trainingTable", "trainingSearch", "pagination");
            setupTable("overviewTable", "overviewSearch", "overviewPagination");

            const suggestedSearch = document.getElementById("suggestedSearch");
            const suggestedRows = document.querySelectorAll(".suggested-row");
            suggestedSearch?.addEventListener("keyup", function () {
                const query = this.value.toLowerCase();
                suggestedRows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(query) ? "" : "none";

                    const collapseId = row.getAttribute("data-bs-target");
                    if (collapseId) {
                        const detailRow = document.querySelector(collapseId);
                        if (detailRow) detailRow.style.display = text.includes(query) ? "" : "none";
                    }
                });
            });


            document.querySelectorAll(".suggested-row").forEach(row => {
                row.addEventListener("click", function () {
                    const icon = this.querySelector(".toggle-icon");
                    const isOpen = this.classList.contains("active");

                    document.querySelectorAll(".suggested-row.active").forEach(r => {
                        r.classList.remove("active");
                        const i = r.querySelector(".toggle-icon");
                        if (i) {
                            i.classList.remove("bi-chevron-up");
                            i.classList.add("bi-chevron-down");
                        }
                    });

                    if (!isOpen) {
                        this.classList.add("active");
                        icon.classList.remove("bi-chevron-down");
                        icon.classList.add("bi-chevron-up");
                    } else {
                        this.classList.remove("active");
                        icon.classList.remove("bi-chevron-up");
                        icon.classList.add("bi-chevron-down");
                    }
                });
            });


            function setupTable(tableId, searchId, paginationId) {
                const table = document.getElementById(tableId);
                if (!table) return;
                const searchInput = document.getElementById(searchId);
                const pagination = document.getElementById(paginationId);
                const rows = Array.from(table.querySelectorAll("tbody tr"));
                const rowsPerPage = 10;
                let currentPage = 1;
                let filteredRows = [...rows];


                searchInput?.addEventListener("keyup", function () {
                    const query = this.value.toLowerCase();
                    filteredRows = rows.filter(row =>
                        Array.from(row.querySelectorAll("td"))
                            .some(td => td.textContent.toLowerCase().includes(query))
                    );
                    currentPage = 1;
                    renderTable(filteredRows);
                });


                const headers = table.querySelectorAll("th");
                headers.forEach((header, index) => {
                    header.style.cursor = "pointer";
                    header.dataset.sort = "none";
                    header.innerHTML = `${header.textContent} <span class="sort-indicator">↕</span>`;
                    header.addEventListener("click", () => sortTable(index, header));
                });

                function sortTable(index, header) {
                    const isAsc = header.dataset.sort !== "asc";
                    headers.forEach(h => {
                        h.dataset.sort = "none";
                        h.querySelector(".sort-indicator").textContent = "↕";
                    });
                    header.dataset.sort = isAsc ? "asc" : "desc";
                    header.querySelector(".sort-indicator").textContent = isAsc ? "▲" : "▼";

                    filteredRows.sort((a, b) => {
                        const aText = a.children[index].innerText.trim();
                        const bText = b.children[index].innerText.trim();
                        return isAsc ? aText.localeCompare(bText) : bText.localeCompare(aText);
                    });
                    renderTable(filteredRows);
                }

                function renderTable(rowSet) {
                    const tbody = table.querySelector("tbody");
                    const totalPages = Math.ceil(rowSet.length / rowsPerPage);
                    currentPage = Math.min(currentPage, totalPages || 1);

                    const start = (currentPage - 1) * rowsPerPage;
                    const end = start + rowsPerPage;
                    const visibleRows = rowSet.slice(start, end);
                    tbody.innerHTML = visibleRows.map(r => r.outerHTML).join("");
                    renderPagination(totalPages, rowSet);
                }

                function renderPagination(totalPages, rowSet) {
                    pagination.innerHTML = "";
                    if (totalPages <= 1) return;

                    const prevDisabled = currentPage === 1 ? "disabled" : "";
                    const nextDisabled = currentPage === totalPages ? "disabled" : "";

                    const pagesToShow = [1, 2, totalPages - 1, totalPages];
                    for (let i = currentPage - 2; i <= currentPage + 2; i++) {
                        if (i > 0 && i <= totalPages) pagesToShow.push(i);
                    }

                    const uniquePages = [...new Set(pagesToShow)].sort((a, b) => a - b);
                    let html = `<li class="page-item ${prevDisabled}"><button class="page-link">Previous</button></li>`;

                    for (let i = 0; i < uniquePages.length; i++) {
                        if (i > 0 && uniquePages[i] - uniquePages[i - 1] > 1) {
                            html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                        }
                        const page = uniquePages[i];
                        html += `<li class="page-item ${currentPage === page ? "active" : ""}">
                                    <button class="page-link">${page}</button>
                                 </li>`;
                    }

                    html += `<li class="page-item ${nextDisabled}"><button class="page-link">Next</button></li>`;
                    pagination.innerHTML = html;

                    pagination.querySelectorAll(".page-link").forEach(btn => {
                        btn.addEventListener("click", () => {
                            if (btn.textContent === "Previous" && currentPage > 1) currentPage--;
                            else if (btn.textContent === "Next" && currentPage < totalPages) currentPage++;
                            else if (!isNaN(btn.textContent)) currentPage = parseInt(btn.textContent);
                            renderTable(rowSet);
                        });
                    });
                }

                renderTable(filteredRows);
            }
        });


            function assignSuggestedTraining(model) {
                const userId = model.ID_GUID;
                window.location.href = `/TrainingRegister/TrainingDetails?userId=${userId}`;
            }

            function goToTrainingDetails() {
                window.location.href = "/TrainingRegister/TrainingDetails";
            }


            function exportTraining() {
                window.location.href = "/TrainingRegister/ExportTraining";
            }


                            
    </script>
}
