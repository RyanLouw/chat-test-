@using CallQuality.Core.Manager.OperatorAssignmentManager.Models
@using CallQuality.DataAccess.CallQualityDataAccess.Models
@model AssignmentVM
@{
    ViewData["Title"] = "IT - Operator Assignments";

    ADUserDTO? FindUserByOperatorId(string? operatorId)
    {
        if (string.IsNullOrWhiteSpace(operatorId))
            return null;

        if (Guid.TryParse(operatorId.Trim(), out var operatorGuid))
        {
            return Model.AllUsers.FirstOrDefault(user =>
                user.ID_Guid == operatorGuid ||
                (
                    Guid.TryParse(user.ID, out var userGuid) &&
                    userGuid == operatorGuid
                ));
        }

        return Model.AllUsers.FirstOrDefault(user =>
            string.Equals(
                user.ID?.Trim(),
                operatorId.Trim(),
                StringComparison.OrdinalIgnoreCase));
    }
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Operator Assignments</h3>

        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" type="button" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs" id="assignTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="tab-current"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-current"
                    type="button"
                    role="tab">
                Current Assignments
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-unassigned"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-unassigned"
                    type="button"
                    role="tab">
                Unassigned Operators
                <span class="badge bg-danger ms-1">
                    @(Model.AvailableOperators?.Count ?? 0)
                </span>
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="tab-bulk"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-bulk"
                    type="button"
                    role="tab">
                Bulk Assign
            </button>
        </li>
    </ul>

    <div class="tab-content pt-3" id="assignTabsContent">

        <!-- TAB 1: Current Assignments -->
        <div class="tab-pane fade show active" id="pane-current" role="tabpanel" aria-labelledby="tab-current">

            <div class="d-flex justify-content-end mb-3">
                <input type="text"
                       id="searchAssignmentsInput"
                       class="form-control"
                       placeholder="Search operator / assessor..."
                       style="max-width: 350px; border-radius: 6px;">
            </div>

            <div class="accordion" id="assignmentsAccordion">
                @if (Model?.OperatorAssignments != null && Model.OperatorAssignments.Any())
                {

                    var assessorGroups = Model.OperatorAssignments
                    .GroupBy(x => x.AssessorId)
                    .OrderBy(g =>
                    {
                        var name = Model.Assessors.FirstOrDefault(a => a.AssessorId == g.Key)?.AssessorName;
                        return name ?? $"#{g.Key}";
                    })
                    .ToList();

                    int idx = 0;

                    foreach (var g in assessorGroups)
                    {
                        var assessor = Model.Assessors.FirstOrDefault(a => a.AssessorId == g.Key);
                        var assessorName = assessor?.AssessorName ?? $"Assessor #{g.Key}";
                        var collapseId = $"collapseAssessor{idx}";
                        var matchedAssignments = g
                        .Where(row => FindUserByOperatorId(row.OperatorId) != null)
                        .ToList();

                        var knownCount = matchedAssignments.Count;
                        <div class="accordion-item mb-3 shadow-sm assignment-accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-semibold"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    <span>@assessorName</span>
                                    <span class="badge bg-secondary ms-3">@knownCount operators</span>
                                </button>
                            </h2>

                            <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#assignmentsAccordion">
                                <div class="accordion-body">

                                    <table class="table table-sm table-striped align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Operator</th>
                                                <th>Assessor</th>
                                                <th>Secondary Assessor</th>
                                                <th>Secondary Start</th>
                                                <th>Secondary End</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var row in matchedAssignments)
                                            {
                                                var user = FindUserByOperatorId(row.OperatorId);

                                                var operatorName = !string.IsNullOrWhiteSpace(user!.DisplayName)
                                                ? user.DisplayName
                                                : $"{user.GivenName} {user.Surname}".Trim();

                                                var primaryAssessorName = Model.Assessors
                                                .FirstOrDefault(a => a.AssessorId == row.AssessorId)
                                                ?.AssessorName
                                                ?? $"#{row.AssessorId}";

                                                var secondaryAssessorName = row.AssessorIdSecondary.HasValue
                                                ? Model.Assessors
                                                .FirstOrDefault(a =>
                                                a.AssessorId == row.AssessorIdSecondary.Value)
                                                ?.AssessorName
                                                ?? $"#{row.AssessorIdSecondary.Value}"
                                                : "-";

                                                <tr>
                                                    <td class="fw-semibold">
                                                        @operatorName


                                                    </td>

                                                    <td>@primaryAssessorName</td>
                                                    <td>@secondaryAssessorName</td>
                                                    <td>@(row.SecondaryStartDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                                    <td>@(row.SecondaryEndDate?.ToString("yyyy-MM-dd") ?? "-")</td>

                                                    <td class="text-end">
                                                        <button type="button"
                                                                class="btn btn-outline-primary btn-sm me-2 btn-edit-assignment"
                                                                data-rowkey="@row.RowKey"
                                                                data-assessor="@row.AssessorId"
                                                                data-secondaryassessor="@(row.AssessorIdSecondary?.ToString() ?? "")"
                                                                data-start="@(row.SecondaryStartDate?.ToString("yyyy-MM-dd") ?? "")"
                                                                data-end="@(row.SecondaryEndDate?.ToString("yyyy-MM-dd") ?? "")">
                                                            Edit
                                                        </button>

                                                        <button type="button"
                                                                class="btn btn-outline-danger btn-sm btn-delete-assignment"
                                                                data-rowkey="@row.RowKey">
                                                            Delete
                                                        </button>
                                                    </td>
                                                </tr>
                                            }


                                        </tbody>

                                    </table>

                                </div>
                            </div>
                        </div>

                        idx++;
                    }
                }
                else
                {
                    <p class="text-center text-muted">No operator assignments found.</p>
                }
            </div>
        </div>

        <!-- Edit modal -->

        <div class="modal fade" id="editAssignmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Edit Assignment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="editRowKey" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Assessor</label>
                            <select id="editAssessorId" class="form-select">
                                <option value="">-- Select assessor --</option>
                                @foreach (var a in Model.Assessors.OrderBy(x => x.AssessorName))
                                {
                                    <option value="@a.AssessorId">@a.AssessorName</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Secondary Assessor</label>
                            <select id="editSecondaryAssessorId" class="form-select">
                                <option value="">-- None --</option>
                                @foreach (var a in Model.Assessors.OrderBy(x => x.AssessorName))
                                {
                                    <option value="@a.AssessorId">@a.AssessorName</option>
                                }
                            </select>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Start date</label>
                                <input type="date" id="editStartDate" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">End date</label>
                                <input type="date" id="editEndDate" class="form-control" />
                            </div>
                        </div>

                        <div class="alert alert-danger mt-3 d-none" id="editError"></div>
                        <div class="alert alert-success mt-3 d-none" id="editSuccess"></div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="btnSaveEdit">
                            <i class="bi bi-save me-1"></i>Save
                        </button>
                    </div>

                </div>
            </div>
        </div>


        <!-- Delete modal -->

        <div class="modal fade" id="deleteAssignmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title text-danger">Delete Assignment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="deleteRowKey" />
                        <p class="mb-0">Are you sure you want to delete this operator assignment?</p>

                        <div class="alert alert-danger mt-3 d-none" id="deleteError"></div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="btnConfirmDelete">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </div>

                </div>
            </div>
        </div>


        <!-- TAB 2: Unassigned Operators -->
        <div class="tab-pane fade" id="pane-unassigned" role="tabpanel" aria-labelledby="tab-unassigned">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="mb-1">Unassigned Operators</h5>
                            <div class="text-muted">
                                These operators are not currently assigned to any assessor.
                            </div>
                        </div>

                        <span class="badge bg-danger fs-6">
                            @(Model.AvailableOperators?.Count ?? 0) unassigned
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assign selected operators to assessor</label>
                            <select id="unassignedAssessorSelect" class="form-select">
                                <option value="">-- Select assessor --</option>
                                @foreach (var a in Model.Assessors.OrderBy(x => x.AssessorName))
                                {
                                    <option value="@a.AssessorId">
                                        @a.AssessorName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Search</label>
                            <input type="text"
                                   id="unassignedOperatorSearch"
                                   class="form-control"
                                   placeholder="Search unassigned operators...">
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-end gap-2 mb-2">
                                <button class="btn btn-outline-secondary btn-sm" type="button" id="btnSelectAllUnassigned">
                                    Select all
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" type="button" id="btnClearAllUnassigned">
                                    Clear
                                </button>
                            </div>

                            <div class="border rounded p-2" style="max-height: 430px; overflow:auto;">
                                <div id="unassignedOperatorList">
                                    @if (Model.AvailableOperators == null || !Model.AvailableOperators.Any())
                                    {
                                        <div class="text-muted text-center py-4">
                                            No unassigned operators found.
                                        </div>
                                    }
                                    else
                                    {
                                        foreach (var u in Model.AvailableOperators.OrderBy(x => x.DisplayName))
                                        {
                                            var operatorName = !string.IsNullOrWhiteSpace(u.DisplayName)
                                            ? u.DisplayName
                                            : $"{u.GivenName} {u.Surname}".Trim();

                                            <div class="form-check unassigned-operator-item py-1 border-bottom">
                                                <input class="form-check-input unassigned-operator-checkbox"
                                                       type="checkbox"
                                                       value="@u.ID"
                                                       id="unassigned_op_@u.ID">

                                                <label class="form-check-label w-100" for="unassigned_op_@u.ID">
                                                    <span class="fw-semibold">@operatorName</span>

                                                    @if (!string.IsNullOrWhiteSpace(u.Department))
                                                    {
                                                        <span class="text-muted ms-2">- @u.Department</span>
                                                    }

                                                    <span class="text-muted ms-2">(@u.ID)</span>
                                                </label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="mt-3 d-flex justify-content-end">
                                <button class="btn btn-success" type="button" id="btnAssignUnassigned">
                                    <i class="bi bi-plus-circle me-2"></i>Assign selected
                                </button>
                            </div>

                            <div class="alert alert-info mt-3 d-none" id="unassignedInfo"></div>
                            <div class="alert alert-danger mt-3 d-none" id="unassignedError"></div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- TAB 3:  Assign -->
        <div class="tab-pane fade" id="pane-bulk" role="tabpanel" aria-labelledby="tab-bulk">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h5 class="mb-3">Bulk assign operators to an assessor</h5>

                    <div class="row g-3">
                        <!-- Manager dropdown -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Manager</label>
                            <select id="managerSelect" class="form-select">
                                <option value="">-- Select manager --</option>
                                @foreach (var m in Model.Managers.OrderBy(x => x.ManagerName))
                                {
                                    <option value="@m.ManagerID" selected="@(Model.SelectedManagerId == m.ManagerID ? "selected" : null)">
                                        @m.ManagerName
                                    </option>
                                }
                            </select>
                            <div class="form-text">Pick a manager to load their operators.</div>
                        </div>

                        <!-- Assessor dropdown -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assessor</label>
                            <select id="assessorSelect" class="form-select">
                                <option value="">-- Select assessor --</option>
                                @foreach (var a in Model.Assessors.OrderBy(x => x.AssessorName))
                                {
                                    <option value="@a.AssessorId">
                                        @a.AssessorName
                                    </option>
                                }
                            </select>
                            <div class="form-text">Operators selected below will be assigned to this assessor.</div>
                        </div>

                        <!-- Operator list -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <label class="form-label fw-semibold mb-0">Operators under manager</label>

                                <div class="d-flex gap-2">
                                    <input type="text"
                                           id="operatorSearch"
                                           class="form-control"
                                           placeholder="Search operators..."
                                           style="max-width: 320px;">
                                    <button class="btn btn-outline-secondary" type="button" id="btnSelectAll">
                                        Select all
                                    </button>
                                    <button class="btn btn-outline-secondary" type="button" id="btnClearAll">
                                        Clear
                                    </button>
                                </div>
                            </div>

                            <div class="border rounded p-2 mt-2" style="max-height: 380px; overflow:auto;">
                                <div id="operatorList">
                                    @if (Model.UsersUnderManager == null)
                                    {
                                        <div class="text-muted">Select a manager to load operators.</div>
                                    }
                                    else if (!Model.UsersUnderManager.Any())
                                    {
                                        <div class="text-muted">No users found under selected manager.</div>
                                    }
                                    else
                                    {
                                        foreach (var u in Model.UsersUnderManager.OrderBy(x => x.UserName))
                                        {
                                            <div class="form-check operator-item">
                                                <input class="form-check-input operator-checkbox"
                                                       type="checkbox"
                                                       value="@u.UserID"
                                                       id="op_@u.UserID">
                                                <label class="form-check-label" for="op_@u.UserID">
                                                    @u.UserName <span class="text-muted">(@u.UserID)</span>
                                                </label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="mt-3 d-flex justify-content-end">
                                <button class="btn btn-success" type="button" id="btnAssign">
                                    <i class="bi bi-plus-circle me-2"></i>Assign selected
                                </button>
                            </div>

                            <div class="alert alert-info mt-3 d-none" id="bulkInfo"></div>
                            <div class="alert alert-danger mt-3 d-none" id="bulkError"></div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        document.querySelectorAll(".btn-edit-assignment").forEach(btn => {
            btn.addEventListener("click", function () {
                const rowKey = this.dataset.rowkey;
                const assessor = this.dataset.assessor || "";
                const secondaryAssessor = this.dataset.secondaryassessor || "";
                const start = this.dataset.start || "";
                const end = this.dataset.end || "";

                document.getElementById("editRowKey").value = rowKey;
                document.getElementById("editAssessorId").value = assessor;
                document.getElementById("editSecondaryAssessorId").value = secondaryAssessor;
                document.getElementById("editStartDate").value = start;
                document.getElementById("editEndDate").value = end;

                document.getElementById("editError").classList.add("d-none");
                document.getElementById("editSuccess").classList.add("d-none");

                new bootstrap.Modal(document.getElementById("editAssignmentModal")).show();
            });
        });


        document.getElementById("btnSaveEdit")?.addEventListener("click", async function () {
            const rowKey = document.getElementById("editRowKey").value;
            const assessorIdVal = document.getElementById("editAssessorId").value;
            const secondaryAssessorIdVal = document.getElementById("editSecondaryAssessorId").value;
            const start = document.getElementById("editStartDate").value;
            const end = document.getElementById("editEndDate").value;

            const err = document.getElementById("editError");
            const ok = document.getElementById("editSuccess");

            err.classList.add("d-none");
            ok.classList.add("d-none");

            if (!assessorIdVal) {
                err.textContent = "Please select an assessor.";
                err.classList.remove("d-none");
                return;
            }

            const payload = {
                rowKey: parseInt(rowKey),
                assessorId: parseInt(assessorIdVal),
                assessorIdSecondary: secondaryAssessorIdVal ? parseInt(secondaryAssessorIdVal) : null,
                secondaryStartDate: start ? start : null,
                secondaryEndDate: end ? end : null
            };

            try {
                const res = await fetch("@Url.Action("UpdateAssignment", "IT")", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();

                if (!res.ok || data.success === false) {
                    err.textContent = data.message || "Update failed.";
                    err.classList.remove("d-none");
                    return;
                }

                ok.textContent = data.message || "Updated.";
                ok.classList.remove("d-none");

                const url = new URL(window.location.href);
                url.searchParams.set("tab", "current");
                window.location.href = url.toString();

            } catch {
                err.textContent = "Update failed (network/server error).";
                err.classList.remove("d-none");
            }
        });


        document.querySelectorAll(".btn-delete-assignment").forEach(btn => {
            btn.addEventListener("click", function () {
                document.getElementById("deleteRowKey").value = this.dataset.rowkey;
                document.getElementById("deleteError").classList.add("d-none");
                new bootstrap.Modal(document.getElementById("deleteAssignmentModal")).show();
            });
        });


        document.getElementById("btnConfirmDelete")?.addEventListener("click", async function () {
            const rowKey = document.getElementById("deleteRowKey").value;
            const err = document.getElementById("deleteError");
            err.classList.add("d-none");

            try {
                const res = await fetch("@Url.Action("DeleteAssignment", "IT")", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ rowKey: parseInt(rowKey) })
                });

                const data = await res.json();
                if (!res.ok || data.success === false) {
                    err.textContent = data.message || "Delete failed.";
                    err.classList.remove("d-none");
                    return;
                }

                location.reload();
            } catch {
                err.textContent = "Delete failed (network/server error).";
                err.classList.remove("d-none");
            }
        });

        document.getElementById("searchAssignmentsInput")?.addEventListener("input", function () {
            const value = this.value.toLowerCase();
            document.querySelectorAll(".assignment-accordion-item").forEach(item => {
                item.style.display = item.innerText.toLowerCase().includes(value) ? "" : "none";
            });
        });

        document.getElementById("operatorSearch")?.addEventListener("input", function () {
            const value = this.value.toLowerCase();
            document.querySelectorAll("#operatorList .operator-item").forEach(item => {
                item.style.display = item.innerText.toLowerCase().includes(value) ? "" : "none";
            });
        });


        document.getElementById("btnSelectAll")?.addEventListener("click", function () {
            document.querySelectorAll(".operator-checkbox").forEach(cb => cb.checked = true);
        });
        document.getElementById("btnClearAll")?.addEventListener("click", function () {
            document.querySelectorAll(".operator-checkbox").forEach(cb => cb.checked = false);
        });


        document.getElementById("managerSelect")?.addEventListener("change", function () {
            const managerId = this.value;
            const url = new URL(window.location.href);

            if (!managerId) url.searchParams.delete("managerId");
            else url.searchParams.set("managerId", managerId);

            url.searchParams.set("tab", "bulk");

            window.location.href = url.toString();
        });

        document.getElementById("btnAssign")?.addEventListener("click", async function () {
            const assessorId = parseInt(document.getElementById("assessorSelect").value);
            const selectedOps = Array.from(document.querySelectorAll(".operator-checkbox:checked")).map(x => x.value);

            const info = document.getElementById("bulkInfo");
            const err = document.getElementById("bulkError");
            info.classList.add("d-none");
            err.classList.add("d-none");

            if (!assessorId) {
                err.textContent = "Please select an assessor.";
                err.classList.remove("d-none");
                return;
            }
            if (selectedOps.length === 0) {
                err.textContent = "Please select at least one operator.";
                err.classList.remove("d-none");
                return;
            }

            try {
                const res = await fetch("@Url.Action("BulkAssign", "IT")", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        assessorId: assessorId,
                        operatorIds: selectedOps
                    })
                });

                const data = await res.json();

                if (!res.ok || data.success === false) {
                    err.textContent = data.message || "Bulk assign failed.";
                    err.classList.remove("d-none");
                    return;
                }

                info.textContent = data.message;
                info.classList.remove("d-none");
                location.reload();

            } catch (e) {
                err.textContent = "Bulk assign failed (network/server error).";
                err.classList.remove("d-none");
            }
        });



        document.querySelectorAll('#assignTabs button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (event) {
                const id = event.target.id;
                const url = new URL(window.location.href);

                if (id === "tab-current") url.searchParams.set("tab", "current");
                if (id === "tab-unassigned") url.searchParams.set("tab", "unassigned");
                if (id === "tab-bulk") url.searchParams.set("tab", "bulk");

                history.replaceState({}, "", url.toString());
            });
        });
                document.getElementById("unassignedOperatorSearch")?.addEventListener("input", function () {
            const value = this.value.toLowerCase();

            document.querySelectorAll("#unassignedOperatorList .unassigned-operator-item").forEach(item => {
                item.style.display = item.innerText.toLowerCase().includes(value) ? "" : "none";
            });
        });

        document.getElementById("btnSelectAllUnassigned")?.addEventListener("click", function () {
            document.querySelectorAll(".unassigned-operator-checkbox").forEach(cb => cb.checked = true);
        });

        document.getElementById("btnClearAllUnassigned")?.addEventListener("click", function () {
            document.querySelectorAll(".unassigned-operator-checkbox").forEach(cb => cb.checked = false);
        });

        document.getElementById("btnAssignUnassigned")?.addEventListener("click", async function () {
            const assessorId = parseInt(document.getElementById("unassignedAssessorSelect").value);
            const selectedOps = Array.from(document.querySelectorAll(".unassigned-operator-checkbox:checked"))
                .map(x => x.value);

            const info = document.getElementById("unassignedInfo");
            const err = document.getElementById("unassignedError");

            info.classList.add("d-none");
            err.classList.add("d-none");

            if (!assessorId) {
                err.textContent = "Please select an assessor.";
                err.classList.remove("d-none");
                return;
            }

            if (selectedOps.length === 0) {
                err.textContent = "Please select at least one operator.";
                err.classList.remove("d-none");
                return;
            }

            try {
                const res = await fetch("@Url.Action("BulkAssign", "IT")", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        assessorId: assessorId,
                        operatorIds: selectedOps
                    })
                });

                const data = await res.json();

                if (!res.ok || data.success === false) {
                    err.textContent = data.message || "Assign failed.";
                    err.classList.remove("d-none");
                    return;
                }

                info.textContent = data.message || "Operators assigned successfully.";
                info.classList.remove("d-none");

                const url = new URL(window.location.href);
                url.searchParams.set("tab", "current");
                window.location.href = url.toString();

            } catch {
                err.textContent = "Assign failed (network/server error).";
                err.classList.remove("d-none");
            }
        });

        (function () {
            const url = new URL(window.location.href);
            const tab = url.searchParams.get("tab");
            if (!tab) return;

            const tabId = tab === "bulk" ? "tab-bulk"
                         : tab === "unassigned" ? "tab-unassigned"
                         : tab === "current" ? "tab-current"
                         : null;

            if (!tabId) return;

            const btn = document.getElementById(tabId);
            if (!btn) return;

            const t = bootstrap.Tab.getOrCreateInstance(btn);
            t.show();
        })();
    </script>
}
